{
	"name": "mcu-watchlist",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply mcu-watchlist --local",
		"db:migrate": "wrangler d1 migrations apply mcu-watchlist --remote",
		"seed:generate": "node scripts/generate-seed.mjs",
		"fonts": "node scripts/fetch-fonts.mjs",
		"deploy": "npm run build && wrangler deploy",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260801.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.2",
		"drizzle-kit": "^0.31.10",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.10",
		"wrangler": "^4.118.0"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"jose": "^6.2.7"
	}
}
