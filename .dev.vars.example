# Copy to .dev.vars (git-ignored) for local development.
#
# In dev, hooks.server.ts skips JWT verification entirely and uses DEV_USER_SUB
# as the identity. This value only needs to be stable — it is the key your
# local ticks are stored under.
DEV_USER_SUB="dev-user"

# Bearer token for /api/*, which the scheduled Claude routine authenticates
# with. If this is unset the whole API surface returns 404 rather than being
# open. Use a long random value in production (`openssl rand -hex 32`).
SYNC_TOKEN="local-dev-token"

# TMDB API Read Access Token (v4 bearer). Only needed to run a real sync.
TMDB_API_KEY=""
